// ### TOP Simple ## //

{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"layer": "top", 
"position": "top", 
//"mode": "dock",
"exclusive": true,
"passthrough": false,
"gtk-layer-shell": true,
"margin-left": 0,
"margin-right": 0,
"margin-top": 0,

"modules-left": [	 
	"hyprland/workspaces#rw",
	"mpris", 
	],
    
"modules-center": [
	"clock",
	"group/notify",
	],
    
"modules-right": [	
	"hyprland/window",
	"group/mobo_drawer",  
	"tray",
	"backlight",
	"network",
	"bluetooth",
    "battery",
 	"group/audio", 
	"custom/power",

	],
}

